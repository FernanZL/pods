# Copy to .env and fill in. Nothing paid runs until you click "Process" in the Library.

# --- Keys ---------------------------------------------------------------
OPENAI_API_KEY=            # required for transcription + embeddings (and chat if LLM_PROVIDER=openai)
OPENROUTER_API_KEY=        # only if LLM_PROVIDER=openrouter

# --- Chat + summaries ------------------------------------------------------
LLM_PROVIDER=openai        # openai | openrouter | fake
LLM_MODEL=gpt-6-luna       # on OpenRouter becomes openai/gpt-6-luna automatically
LLM_REASONING_EFFORT=low   # none | low | medium | high

# --- Transcription -------------------------------------------------------
TRANSCRIBER=openai_diarize # openai_diarize (speaker labels) | openai_text (gpt-transcribe + LLM attribution) | fake
DIARIZE_MODEL=gpt-4o-transcribe-diarize   # OpenAI sunsets this model on 2027-02-26
TEXT_TRANSCRIBE_MODEL=gpt-transcribe
TRANSCRIBE_PARALLELISM=6        # chunks sent at once after the first (per episode)
TRANSCRIBE_TIMEOUT_SECONDS=900  # per request; slow requests are logged, never silently re-sent
# Prices (USD). Real costs are metered from OpenAI's usage; these seed the first estimates.
# PRICE_DIARIZE_PER_MIN=0.021          # measured; OpenAI's listed $0.006/min is far too low
# PRICE_DIARIZE_INPUT_PER_MTOK=2.50
# PRICE_DIARIZE_OUTPUT_PER_MTOK=10.00

# --- Embeddings -----------------------------------------------------------
EMBEDDINGS_PROVIDER=openai # openai | fake
EMBEDDING_MODEL=text-embedding-3-small

# --- Misc -----------------------------------------------------------------
JOB_CONCURRENCY=2
DOWNLOAD_MODE=real         # real | fake (writes placeholder audio, no network)

# Demo mode (free, offline): set LLM_PROVIDER=fake TRANSCRIBER=fake EMBEDDINGS_PROVIDER=fake DOWNLOAD_MODE=fake
